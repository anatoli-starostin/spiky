# Copy to run.env (same folder) and fill in every value marked FILL. launch.sh and preflight.py read run.env.
# Nothing here is machine-specific until you fill it; keep run.env out of git (it names local paths).

# --- code -----------------------------------------------------------------------------------------------------------
# Your spiky checkout. It MUST be at the pinned commit (preflight checks):
#   research/ffn_replacement_fix @ 4ad02234900413fa7555e4c4048de80fae4346f5
# This folder must sit at $SPIKY_ROOT/experiments/ffn_replacement/lut_ablation/<this folder> (train.py finds tools/ by walking up).
SPIKY_ROOT=FILL                       # e.g. /home/<you>/projects/spiky
PYTHON=FILL                           # the venv python with spiky + lutorch_cuda installed, e.g. $SPIKY_ROOT/.venv/bin/python
NANOCHAT_ROOT=FILL                    # nanochat checkout at da32e1d657b62cc1110f20f86fbc301d6189726e (preflight checks)

# --- data -----------------------------------------------------------------------------------------------------------
# Directory holding base_data_climbmix/ (EXACTLY the 5 shards in data_manifest.json) and tokenizer/ (2 files).
NANOCHAT_BASE_DIR=FILL                # e.g. /home/<you>/.cache/nanochat

# --- GPU ------------------------------------------------------------------------------------------------------------
# The trainer is SINGLE-GPU (no DDP): expose exactly one device. Do not give it more; they would sit idle.
CUDA_VISIBLE_DEVICES=0

# --- p2_int8 implementation (decided by the kernel gate: validate_kernel.py) -----------------------------------------
# Leave UNSET (commented) to train on the CUDA kernel -- allowed ONLY after `KERNEL GATE: PASS`.
# If the gate FAILED: uncomment to train on the torch definition (bit-identical integers, slower), and report the failures.
# SPIKY_P2_CUDA_DISABLE=1

# --- outputs --------------------------------------------------------------------------------------------------------
# metrics.csv / summary.json / loss.png / checkpoint*.pt / train.log are written INTO THIS FOLDER (the trainer's design).
# Periodic crash-insurance checkpoints every CKPT_EVERY steps (~270 MB each). 8000 -> 5 intermediate files.
CKPT_EVERY=8000
TRITON_CACHE_DIR=FILL                 # a writable cache dir, e.g. /home/<you>/.cache/triton

# --- W&B: LIVE CLOUD LOGGING (required) ------------------------------------------------------------------------------
# Log to wandb.ai cloud so the run is visible while it trains. The self-hosted server that ~/.wandb_env points at is
# DOWN: do NOT source ~/.wandb_env for this run. The cloud API key is ALREADY in ~/.netrc under `machine api.wandb.ai`
# (verified on nebius 2026-09-16); preflight re-checks that it authenticates, without printing it. Never put a key here.
WANDB_BASE_URL=https://api.wandb.ai
# Leave WANDB_ENTITY empty to log to the key's default entity (the owner's account, where the 16K twin run logs).
WANDB_ENTITY=
# Project is fixed by the trainer's shim ("Spiky"), group by train.py ("lut_ablation"), run name/id = exp_name.
