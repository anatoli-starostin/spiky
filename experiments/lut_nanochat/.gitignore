# Model weights and optimizer state never enter git (a d24 checkpoint is ~10 GB per step).
# The launcher keeps them in results/<run>/checkpoints/ next to the run's other artifacts.
results/*/checkpoints/
*.pt
# Analysis reports are committed as LaTeX source only: no rendered PDFs or LaTeX build output.
results/*/analysis/**/*.pdf
results/*/analysis/**/*.aux
results/*/analysis/**/*.log
results/*/analysis/**/*.out
results/*/analysis/**/*.toc
