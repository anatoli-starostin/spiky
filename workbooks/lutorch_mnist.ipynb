  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# LUTorch MNIST with ProjectionLUT\n",
        "\n",
        "This notebook trains and visualizes a simple MNIST classifier using the LUTorch\n",
        "ProjectionLUT module (built on top of MultiHeadLut). The model structure matches\n",
        "the SimpleLUTConv model defined in mnist_processor.py."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import logging\n",
        "import os\n",
        "from typing import Tuple\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.patches as patches\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import torchvision\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from torchvision.transforms.functional import to_pil_image\n",
        "from tqdm.notebook import tqdm\n",
        "\n",
        "from spiky.lut_fused.LUTLayer import LUTLayerBasic\n",
        "from spiky.util.visual_helpers import grayscale_to_red_and_blue\n",
        "from spiky.lutorch.multi_head_lut import ProjectionLut as LUTorchProjectionLUT, UnfoldConfiguration\n",
        "\n",
        "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
        "random_seed = 1\n",
        "torch.manual_seed(random_seed)\n",
        "np.random.seed(random_seed)\n",
        "torch.backends.cudnn.enabled = True\n",
        "\n",
        "logging.basicConfig(level=logging.INFO)\n",
        "logging.info(f'Using device: {device}')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "class SimpleLUTConv(nn.Module):\n",
        "    \"\"\"Two-layer ProjectionLUT-based conv-like network for MNIST using LUTorch.\"\"\"\n",
        "\n",
        "    def __init__(self, device: torch.device, input_shape: Tuple[int, int], num_classes: int):\n",
        "        super().__init__()\n",
        "\n",
        "        H, W = input_shape\n",
        "\n",
        "        # First ProjectionLUT: unfold 28x28, fold back to 56x56\n",
        "        unfold1 = UnfoldConfiguration(\n",
        "            H=H,\n",
        "            W=W,\n",
        "            kernel_size=4,\n",
        "            stride=4,\n",
        "        )\n",
        "        fold1 = UnfoldConfiguration(\n",
        "            H=H * 2,\n",
        "            W=W * 2,\n",
        "            kernel_size=8,\n",
        "            stride=8,\n",
        "        )\n",
        "        O1 = 8\n",
        "        self.proj1 = LUTorchProjectionLUT(\n",
        "            unfold_config=unfold1,\n",
        "            O=O1,\n",
        "            n_anchor_pairs=4,\n",
        "            tables_per_head=1,\n",
        "            fold_config=fold1,\n",
        "            device=device,\n",
        "        )\n",
        "\n",
        "        # Second ProjectionLUT: unfold 56x56, no folding (patch features)\n",
        "        unfold2 = UnfoldConfiguration(\n",
        "            H=H * 2,\n",
        "            W=W * 2,\n",
        "            kernel_size=8,\n",
        "            stride=8,\n",
        "        )\n",
        "        O2 = 8\n",
        "        self.proj2 = LUTorchProjectionLUT(\n",
        "            unfold_config=unfold2,\n",
        "            O=O2,\n",
        "            n_anchor_pairs=4,\n",
        "            tables_per_head=1,\n",
        "            device=device,\n",
        "        )\n",
        "\n",
        "        H_p2, W_p2 = self.proj2.H_p, self.proj2.W_p\n",
        "        self.H_p2, self.W_p2, self.O2 = H_p2, W_p2, O2\n",
        "\n",
        "        self.final_layer = nn.Linear(H_p2 * W_p2 * O2, num_classes, device=device)\n",
        "\n",
        "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
        "        # x: [B, H, W]\n",
        "        x1 = self.proj1(x)  # [B, 2H, 2W]\n",
        "        self._l1_res = x1\n",
        "        x2 = self.proj2(x1)  # [B, H_p2, W_p2, O2]\n",
        "        self._l2_res = x2\n",
        "        return self.final_layer(x2.view(x.shape[0], -1))\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def load_mnist(device: torch.device):\n",
        "    mnist_dataset_dir = 'mnist'\n",
        "\n",
        "    train_raw = torchvision.datasets.MNIST(\n",
        "        mnist_dataset_dir, train=True, download=True\n",
        "    )\n",
        "    test_raw = torchvision.datasets.MNIST(\n",
        "        mnist_dataset_dir, train=False, download=True\n",
        "    )\n",
        "\n",
        "    train_data = train_raw.data.to(device=device, dtype=torch.float32) / 255.0\n",
        "    test_data = test_raw.data.to(device=device, dtype=torch.float32) / 255.0\n",
        "    train_targets = train_raw.targets.to(device=device)\n",
        "    test_targets = test_raw.targets.to(device=device)\n",
        "\n",
        "    train_ds = TensorDataset(train_data, train_targets)\n",
        "    test_ds = TensorDataset(test_data, test_targets)\n",
        "    return train_ds, test_ds\n",
        "\n",
        "\n",
        "def visualize_example(train_loader):\n",
        "    batch, targets = next(iter(train_loader))\n",
        "    img = to_pil_image(batch[0].cpu())\n",
        "    display(img)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def visualize_layer2_output_heatmap(model: SimpleLUTConv, train_loader, device: torch.device):\n",
        "    \"\"\"Visualize a heatmap of layer2 output using grayscale_to_red_and_blue.\"\"\"\n",
        "    example_data, _ = next(iter(train_loader))\n",
        "    example_data = example_data.to(device)\n",
        "    _ = model(example_data)\n",
        "    # Use the 7th example (index 6)\n",
        "    l = model._l2_res[6]\n",
        "    img = grayscale_to_red_and_blue(l, do_clip=False)\n",
        "    color_rescaler = 1.0 / (img.abs().max() + 1e-10)\n",
        "    img = (img * color_rescaler).clip(0.0, 1.0)\n",
        "    pil = to_pil_image(img)\n",
        "    pil = pil.resize([256, 256], resample=0)\n",
        "    display(pil)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Training and evaluation\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "input_shape = (28, 28)\n",
        "num_classes = 10\n",
        "\n",
        "train_ds, test_ds = load_mnist(device)\n",
        "batch_size = 128\n",
        "train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)\n",
        "test_loader = DataLoader(test_ds, batch_size=batch_size, shuffle=False)\n",
        "\n",
        "model = SimpleLUTConv(device=device, input_shape=input_shape, num_classes=num_classes).to(device)\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
        "num_epochs = 3\n",
        "\n",
        "total_params = sum(p.numel() for p in model.parameters())\n",
        "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
        "print(model)\n",
        "print(f\"Total parameters: {total_params:,}\")\n",
        "print(f\"Trainable parameters: {trainable_params:,}\")\n",
        "\n",
        "for epoch in range(num_epochs):\n",
        "    model.train()\n",
        "    running_loss = 0.0\n",
        "    correct = 0\n",
        "    total = 0\n",
        "\n",
        "    for images, targets in tqdm(train_loader, desc=f\"Epoch {epoch+1}/{num_epochs}\"):\n",
        "        # images: [B, 28, 28]\n",
        "        logits = model(images)\n",
        "        loss = criterion(logits, targets)\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        running_loss += loss.item() * images.size(0)\n",
        "        _, predicted = logits.max(1)\n",
        "        total += targets.size(0)\n",
        "        correct += predicted.eq(targets).sum().item()\n",
        "\n",
        "    epoch_loss = running_loss / total\n",
        "    epoch_acc = correct / total\n",
        "    print(f\"Epoch {epoch+1}: loss={epoch_loss:.4f}, acc={epoch_acc:.4f}\")\n",
        "\n",
        "model.eval()\n",
        "correct = 0\n",
        "total = 0\n",
        "with torch.no_grad():\n",
        "    for images, targets in test_loader:\n",
        "        logits = model(images)\n",
        "        _, predicted = logits.max(1)\n",
        "        total += targets.size(0)\n",
        "        correct += predicted.eq(targets).sum().item()\n",
        "\n",
        "test_acc = correct / total\n",
        "print(f\"Test accuracy: {test_acc:.4f}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Visualizations\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Example input image\n",
        "visualize_example(train_loader)\n",
        "\n",
        "# Layer-2 output heatmap\n",
        "visualize_layer2_output_heatmap(model, train_loader, device=device)\n"
      ]
    }
  ],
