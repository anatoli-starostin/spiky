{
  "exp_name": "exp026_smooth_delta_reg",
  "description": "Same as exp023 but with delta regularizer (delta_reg_weight=0.01) to force large anchor deltas.",
  "model": "LUTTransformerV2",
  "vocab_size": 257,
  "embedding_dim": 32,
  "num_layers": 6,
  "num_heads": 4,
  "hidden_dim_ffn": 256,
  "n_anchor_pairs": 8,
  "tables_per_head": 128,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": true,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "delta_reg_weight": 0.01,
  "n_steps": 100000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
