{
  "exp_name": "exp389_kendall_abs_short",
  "description": "Fork of exp385. Replace atanh log-odds with sharper Kendall-tau metric: base = k·|k| = sign(k)·k². Compresses near 0 (soft at random pair alignment), quadratic growth at tails (sharper at confident agreement). Bounded in [-1, 1]. Logits = α · base + token_bias. final_tph=3072, bs=8 × 25k.",
  "final_input_nap": 10,
  "final_tph": 3072,
  "final_partition_by_layer": true,
  "out_tph_per_layer": [2048, 2048, 1024, 512, 256, 256],
  "v_tph_per_layer": [512, 512, 256, 128, 64, 64],
  "model": "FullBitPermRankAttn_ctx128",
  "vocab_size": 257,
  "context_size": 128,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 24,
  "d_v": 16,
  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 256,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 256,
  "out_input_nap": 10,
  "out_output_nap": 32,
  "out_tph": 1024,
  "canon_temperature": 0.1,
  "learnable_attn_scale_init": 0.25,
  "causal": true,
  "random_seed": 42,
  "adam_lr": 0.001,
  "bit_lut_lr": 0.001,
  "unembedder_adam_lr": 0.001,
  "unembedder_bit_lut_lr": 0.001,
  "bit_lut_latent_init_std": 0.001,
  "n_steps": 25000,
  "batch_size": 8,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "bit_lut_latent_dtype": "bf16",
  "bit_lut_soft_backward": true
}
