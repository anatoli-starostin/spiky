{
  "exp_name": "exp126_conv2d_d40p24_concat",
  "description": "Fork of exp124. CONV2D anchor sampling policy. embedding_dim=40, positional_dim=24, concat PE giving input_dim=64 (8x8 grid, 56 tph). out_proj input_dim=64 (also 8x8, 56 tph). nap=8 (required by CONV2D). shuffle_per_head=True (head 0 unshuffled).",
  "model": "LUTTransformerFFN",
  "rank_attn_temperature": 0.5,
  "vocab_size": 257,
  "embedding_dim": 40,
  "positional_dim": 24,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "d_v": 16,
  "n_anchor_pairs": 8,
  "qkv_tables_per_head": 4096,
  "out_proj_tables_per_head": 4096,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "conv2d",
  "shuffle_per_head": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 32,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
