  "d_v": 8,
  "nap_qk": 5,
  "nap_v": 5,
  "tph": 128,
  "nap_out": 10,
  "tph_out": 1024,
  "rank_attn_temperature": 0.1,
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "n_steps": 100000,
  "batch_size": 32,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
