{
  "exp_name": "exp163_self_excitement",
  "description": "Fork of exp161 with self_excitement=True. Each pair weighted by mean |activation| before scatter-sum.",
  "model": "LUTTransformerV2",
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "n_heads": 1,
  "n_outputs_per_head": 32,
  "n_anchor_pairs": 4,
  "tables_per_head": 1024,
  "n_alternatives": 1,
  "smooth_mode": false,
  "causal": true,
  "include_diagonal": true,
  "self_excitement": true,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "full_coverage",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 32,
  "test_batch_size": 32,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "quant_reg_D": 256,
  "quant_reg_lambda_max": 0.0,
  "quant_reg_start_fraction": 0.2
}
