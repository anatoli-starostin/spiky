{
  "exp_name": "exp281_bitflip",
  "description": "exp280 arch but PermLut weights trained via BitFlipOptimizer (±1 binary). STE backward for gradient flow. 25K bs=64 ctx=32.",
  "model": "FullPermConcatLayers",
  "vocab_size": 257,
  "context_size": 32,
  "embedding_dim": 32,
  "pos_dim": 16,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 16,
  "d_v": 8,
  "qk_input_nap": 6,
  "qk_output_nap": 16,
  "qk_tph": 256,
  "v_input_nap": 6,
  "v_output_nap": 4,
  "v_tph": 256,
  "out_input_nap": 6,
  "out_output_nap": 32,
  "out_tph": 2048,
  "soft_mode": "ste",
  "temperature": 0.1,
  "rank_attn_temperature": 0.1,
  "bitflip_n_samples": 32,
  "bitflip_flip_ratio": 0.05,
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam+BitFlip",
  "lr": 0.001,
  "n_steps": 25000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
