{
  "exp_name": "exp099_nap6_normalize_weights",
  "description": "Fork of exp098. normalise_weights=true for attention LUTs (unembedder keeps false). nap=6, tph=512, temperature=0.5, no FFN, batch=32, 100k steps.",
  "model": "LUTTransformerV2",
  "rank_attn_temperature": 0.5,
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "d_v": 16,
  "n_anchor_pairs": 6,
  "tables_per_head": 512,
  "qkv_tables_per_head": 512,
  "out_proj_tables_per_head": 512,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": true,
  "calibrate_output": false,
  "anchor_sampling_policy": "full_coverage",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 100000,
  "batch_size": 32,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
