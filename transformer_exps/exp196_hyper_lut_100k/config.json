{
  "exp_name": "exp196_hyper_lut_100k",
  "description": "HyperLUT big run: score(1024p,h48), value(496p,h96), outproj(2016p,h192), rational, 100K, bs128.",
  "model": "LUTTransformerV3HyperLUT",
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "n_heads": 4,
  "d_v": 16,
  "score_n_pairs": 1024,
  "score_hidden": 48,
  "value_n_pairs": 496,
  "value_hidden": 96,
  "outproj_n_pairs": 2016,
  "outproj_hidden": 192,
  "temperature": 0.1,
  "soft_mode": "rational",
  "causal": true,
  "include_diagonal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 100000,
  "batch_size": 128,
  "test_batch_size": 128,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
