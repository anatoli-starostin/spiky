{
  "exp_name": "exp104_residual_stream",
  "description": "Fork of exp100. Separate residual stream (res_dim=128) updated via up_proj after each LUT block. Ranking stream is raw LUT chain with no skip connections. nap=6, tph=512, temperature=0.5, batch=16, 50k steps.",
  "model": "LUTTransformerV3",
  "rank_attn_temperature": 0.5,
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "res_dim": 128,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "d_v": 16,
  "n_anchor_pairs": 6,
  "tables_per_head": 512,
  "qkv_tables_per_head": 512,
  "out_proj_tables_per_head": 512,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "full_coverage",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 16,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
