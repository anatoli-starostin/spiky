{
  "exp_name": "exp347_cfc_out_multibit_k4",
  "description": "Fork of exp346 (PermLut+q16 out_proj). Replaces PermLut with MultiBitPermutationLUT (bit_width=4, rational pre-quant T=0.1). Same logical shape (in=10, tph=256, out_nap=32), same 16-level vote quantization. Uses DominanceToVector(E) after out_proj (Borda+LN), matching exp329 pattern — MultiBit emits pair dominance unlike PermLut.",
  "out_bit_width": 4,
  "out_pre_quant_temperature": 0.1,
  "model": "FullBitPermRankAttn_ctx128",
  "vocab_size": 257,
  "context_size": 128,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 24,
  "d_v": 16,
  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 192,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 128,
  "out_input_nap": 10,
  "out_output_nap": 32,
  "out_tph": 256,
  "canon_temperature": 0.1,
  "learnable_attn_scale_init": 0.25,
  "causal": true,
  "random_seed": 42,
  "adam_lr": 0.001,
  "bit_lut_lr": 0.001,
  "bit_lut_latent_init_std": 0.001,
  "n_steps": 25000,
  "batch_size": 8,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "bit_lut_latent_dtype": "bf16",
  "bit_lut_soft_backward": true,
  "out_partition_by_head": true
}
