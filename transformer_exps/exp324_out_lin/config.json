  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 192,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 128,
  "out_input_nap": 6,
  "out_input_tph": 512,
  "out_voting_nap": 256,
  "out_V": 2048,
