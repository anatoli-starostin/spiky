{
  "exp_name": "exp297_rankattn_soft_sdpa",
  "description": "exp296 (RankAttn d_qk=24 scaled) + sdpa_temperature=16 -> softmax input std ~0.25, matching exp294's attention sharpness. Tests whether the quality gap to dominance-SDPA is due to attention sharpness (not info loss).",
  "model": "FullPermRankAttn_ctx128",
  "vocab_size": 257,
  "context_size": 128,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 24,
  "d_v": 16,
  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 192,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 128,
  "out_input_nap": 10,
  "out_output_nap": 32,
  "out_tph": 1024,
  "soft_mode": "ste",
  "temperature": 0.1,
  "rank_attn_temperature": 0.1,
  "learnable_attn_scale_init": 0.25,
  "scrambled_policy": "canonical_distinct",
  "input_anchor_policy": "canonical_distinct",
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "n_steps": 25000,
  "batch_size": 8,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
