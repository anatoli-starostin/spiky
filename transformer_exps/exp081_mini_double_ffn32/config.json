{
  "exp_name": "exp081_mini_double_ffn32",
  "description": "Fork of exp075 with 2-layer FFN: ffn1 (24→32) + ffn2 (32→24) instead of single ffn (24→24). tph=256 everywhere. Tests whether a small expansion in the middle adds capacity without changing the rest of the architecture.",
  "model": "LUTTransformerV2",
  "vocab_size": 257,
  "embedding_dim": 24,
  "ffn_mid_dim": 32,
  "positional_dim": 8,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "n_anchor_pairs": 4,
  "tables_per_head": 256,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "full_coverage",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
