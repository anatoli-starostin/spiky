{
  "exp_name": "exp311_fp32_soft",
  "description": "Fork of exp299 with latent_dtype=fp32 AND soft_backward=True. Soft backward now supported via on-the-fly fp8 conversion of latent_fp32 for the CUDA kernel (quant noise only affects grad upstream to embeddings, not weight_grad).",
  "model": "FullBitPermRankAttn_ctx128",
  "vocab_size": 257,
  "context_size": 128,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 24,
  "d_v": 16,
  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 192,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 128,
  "out_input_nap": 10,
  "out_output_nap": 32,
  "out_tph": 1024,
  "rank_attn_temperature": 0.1,
  "learnable_attn_scale_init": 0.25,
  "causal": true,
  "random_seed": 42,
  "adam_lr": 0.001,
  "bit_lut_lr": 0.001,
  "bit_lut_latent_init_std": 0.001,
  "n_steps": 25000,
  "batch_size": 8,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "bit_lut_latent_dtype": "fp32",
  "bit_lut_soft_backward": true
}