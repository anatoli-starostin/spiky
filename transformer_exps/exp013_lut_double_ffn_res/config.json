{
  "exp_name": "exp013_lut_double_ffn_res",
  "description": "Same as exp012 but with residual connection between ffn1 and ffn2.",
  "model": "LUTTransformerV2",
  "vocab_size": 257,
  "embedding_dim": 64,
  "num_layers": 6,
  "num_heads": 4,
  "hidden_dim_ffn": 256,
  "n_anchor_pairs": 10,
  "tables_per_head": 96,
  "n_alternatives": 3,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 100000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
