{
  "exp_name": "exp114_multihead_lut",
  "description": "Fork of exp113. q/k/v: n_heads=64, n_outputs=1, tph=128, reshape to [B*T, 4, 16]. out_proj: n_heads=32, n_outputs=1, tph=128, reshape to [B*T, 1, 32]. No FFN. batch=32, nap=6, temperature=0.5.",
