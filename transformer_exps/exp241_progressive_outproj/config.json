{
  "exp_name": "exp241_progressive_outproj",
  "description": "Progressive out_proj: L0 nap4/tph2048, L1 nap5/tph1024, L2 nap6/tph512, L3 nap7/tph256, L4 nap8/tph128, L5 nap9/tph64. No FFN.",
  "model": "LUTRankAttnFFN",
  "vocab_size": 257,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 8,
  "d_v": 8,
  "nap_qk": 5,
  "nap_v": 6,
  "tph": 128,
  "outproj_schedule": [
    {"nap": 4, "tph": 2048},
    {"nap": 5, "tph": 1024},
    {"nap": 6, "tph": 512},
    {"nap": 7, "tph": 256},
    {"nap": 8, "tph": 128},
    {"nap": 9, "tph": 64}
  ],
  "n_alternatives": 1,
  "smooth_mode": false,
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 100000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
