{
  "exp_name": "exp256_perm_lut",
  "description": "exp252 with PermutationalLut for out_proj only (scrambled). Q/K/V are standard MultiHeadLut.",
  "model": "ConcatLayersPermOut",
  "vocab_size": 257,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 8,
  "d_v": 8,
  "nap_qk": 5,
  "nap_v": 5,
  "tph": 128,
  "input_nap_out": 10,
  "output_nap_out": 16,
  "tph_out": 512,
  "soft_mode": "rational",
  "temperature": 0.1,
  "perm_lr_mult": 1.0,
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "n_steps": 100000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
