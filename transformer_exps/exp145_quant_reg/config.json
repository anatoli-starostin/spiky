{
  "exp_name": "exp145_quant_reg",
  "description": "Fork of exp135. Quantization regularization: L_quant = lambda * sum(sin^2(pi * w * D)). D=256, lambda annealed 0->0.01 over last 80% of training.",
  "model": "LUTTransformerLinearUnemb",
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "d_v": 16,
  "n_anchor_pairs": 4,
  "tables_per_head": 256,
  "qkv_tables_per_head": 264,
  "out_proj_tables_per_head": 480,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "full_coverage",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 32,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "quant_reg_D": 64,
  "quant_reg_lambda_max": 0.01,
  "quant_reg_start_fraction": 0.2
}
