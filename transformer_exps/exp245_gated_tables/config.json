  "table_gating_temp_start": 1.0,
  "table_gating_temp_end": 10.0,
  "n_alternatives": 1,
  "smooth_mode": false,
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 100000,
  "batch_size": 128,
