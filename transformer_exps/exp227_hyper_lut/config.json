{
  "exp_name": "exp227_hyper_lut",
  "description": "HyperLUT transformer. n_pairs=256, hidden_dim=1024, rational soft_mode, temp=0.1.",
  "model": "HyperLUTTransformer",
  "vocab_size": 257,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 8,
  "d_v": 8,
  "n_pairs": 256,
  "hidden_dim": 1024,
  "temperature": 0.1,
  "soft_mode": "rational",
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 256,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
