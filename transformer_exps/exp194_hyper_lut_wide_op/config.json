{
  "exp_name": "exp194_hyper_lut_wide_op",
  "description": "HyperLUT with per-component hidden dims: score=32, value=64, outproj=256.",
  "model": "LUTTransformerV3HyperLUT",
  "vocab_size": 257,
  "embedding_dim": 32,
