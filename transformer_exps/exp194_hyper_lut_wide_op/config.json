  "score_hidden": 32,
  "value_n_pairs": 496,
  "value_hidden": 64,
  "outproj_n_pairs": 2016,
  "outproj_hidden": 256,
  "temperature": 0.1,
  "causal": true,
  "include_diagonal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 25000,
  "batch_size": 32,
  "test_batch_size": 32,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.0
}
