{
  "exp_name": "exp116_hierarchical_nap4",
  "description": "Fork of exp113. HIERARCHICAL anchor sampling, nap=4. q/k/v tph=2048 (auto->74), out_proj tph=2048 (auto->104). No FFN. batch=32, temperature=0.5.",
  "model": "LUTTransformerFFN",
  "rank_attn_temperature": 0.5,
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "d_v": 16,
  "n_anchor_pairs": 4,
  "qkv_tables_per_head": 2048,
  "out_proj_tables_per_head": 2048,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "hierarchical",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 32,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
