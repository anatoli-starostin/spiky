{
  "exp_name": "exp350_cfc_all_multibit_k4_qktph64",
  "description": "Fork of exp349. Same all-MultiBit K=4 arch, but shrink qk_tph 192 -> 64 (3x smaller). At K=4 each table has more bits per vote, so fewer tables may suffice for q/k. Tests the 'q/k too heavy' hypothesis.",
  "qk_bit_width": 4,
  "v_bit_width": 4,
  "out_bit_width": 4,
  "pre_quant_temperature": 0.1,
  "out_pre_quant_temperature": 0.1,
  "model": "FullBitPermRankAttn_ctx128",
  "vocab_size": 257,
  "context_size": 128,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 24,
  "d_v": 16,
  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 64,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 128,
  "out_input_nap": 10,
  "out_output_nap": 32,
  "out_tph": 256,
  "canon_temperature": 0.1,
  "learnable_attn_scale_init": 0.25,
  "causal": true,
  "random_seed": 42,
  "adam_lr": 0.001,
  "bit_lut_lr": 0.001,
  "bit_lut_latent_init_std": 0.001,
  "n_steps": 25000,
  "batch_size": 8,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "bit_lut_latent_dtype": "bf16",
  "bit_lut_soft_backward": true,
  "out_partition_by_head": true
}
