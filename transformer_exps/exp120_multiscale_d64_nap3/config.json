{
  "exp_name": "exp120_multiscale_d64_nap3",
  "description": "Fork of exp119. HIERARCHICAL nap=3. embedding_dim=64, positional_dim=64, interleaved as [e1,p1,...,e64,p64] giving input_dim=128 (auto->234 tph). d_qk=d_v=32, out_proj input_dim=128 (auto->234). No FFN. batch=32, temperature=0.5.",
  "model": "LUTTransformerFFN",
  "rank_attn_temperature": 0.5,
  "vocab_size": 257,
  "embedding_dim": 64,
  "positional_dim": 64,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 32,
  "d_v": 32,
  "n_anchor_pairs": 3,
  "qkv_tables_per_head": 4096,
  "out_proj_tables_per_head": 4096,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "hierarchical",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 32,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
