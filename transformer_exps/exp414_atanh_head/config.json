{
  "exp_name": "exp414_atanh_head",
  "description": "Fork of exp413. Same BitMultiHeadLUT(192->257, partition_sets=per-layer) but scale=1/votes_per_output so output ∈ [-1, 1]. Apply 2·atanh(clamped) to expand the bounded vote sum into unbounded log-odds; then α = exp(log_logit_scale) (init=3.3 → α≈27 matching exp386) + per-token logit_bias.",
  "log_logit_scale_init": 3.3,
  "per_layer_embedding_dim": [32, 32, 32, 32, 32, 32],
  "pos_emb_dim": 32,
  "pos_emb_init_scale": 1.0,
  "final_lut": {
    "input_nap": 10,
    "output_nap": 32,
    "tph": 3072
  },
  "out_tph_per_layer": [2048, 2048, 1024, 512, 256, 256],
  "v_tph_per_layer": [512, 512, 256, 128, 64, 64],
  "model": "FullBitPermRankAttn_ctx128",
  "vocab_size": 257,
  "context_size": 128,
  "embedding_dim": 32,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 24,
  "d_v": 16,
  "qk_input_nap": 5,
  "qk_output_nap": 24,
  "qk_tph": 512,
  "v_input_nap": 5,
  "v_output_nap": 16,
  "v_tph": 256,
  "out_input_nap": 10,
  "out_output_nap": 32,
  "out_tph": 1024,
  "canon_temperature": 0.1,
  "learnable_attn_scale_init": 0.25,
  "causal": true,
  "random_seed": 42,
  "adam_lr": 0.001,
  "bit_lut_lr": 0.001,
  "unembedder_adam_lr": 0.001,
  "unembedder_bit_lut_lr": 0.001,
  "bit_lut_latent_init_std": 0.001,
  "n_steps": 25000,
  "batch_size": 8,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1,
  "bit_lut_latent_dtype": "bf16",
  "bit_lut_soft_backward": true
}
