{
  "exp_name": "exp195_hyper_lut_big",
  "description": "HyperLUT: score(1024p,hid32), value(496p,hid64), outproj(2016p,hid128), rational.",
  "model": "LUTTransformerV3HyperLUT",
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "n_heads": 4,
  "d_v": 16,
  "score_n_pairs": 1024,
  "score_hidden": 32,
  "value_n_pairs": 496,
  "value_hidden": 64,
  "outproj_n_pairs": 2016,
  "outproj_hidden": 128,
  "temperature": 0.1,
  "soft_mode": "rational",
  "causal": true,
  "include_diagonal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 64,
  "test_batch_size": 64,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
