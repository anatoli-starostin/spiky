{
  "exp_name": "exp074_mini_tph256_nap4_fc_dqk16",
  "description": "Fork of exp066 (tph=256, nap=4, FULL_COVERAGE) with d_qk=16 instead of d_head=8. q/k LUTs output 16 per head, v stays at 8. ~6.5M params. 50k steps.",
  "model": "LUTTransformerV2",
  "vocab_size": 257,
  "embedding_dim": 32,
  "num_layers": 6,
  "num_heads": 4,
  "d_qk": 16,
  "n_anchor_pairs": 4,
  "tables_per_head": 256,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "anchor_sampling_policy": "full_coverage",
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
