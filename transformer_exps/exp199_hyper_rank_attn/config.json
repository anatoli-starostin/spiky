{
  "exp_name": "exp199_hyper_rank_attn",
  "description": "HyperLUT RankAttention: Q/K(512p,h32) + V(496p,h96) + SDPA + OutProj(2016p,h192), rational.",
  "model": "HyperRankAttn",
  "vocab_size": 257,
  "embedding_dim": 32,
  "positional_dim": 16,
  "num_layers": 6,
  "n_heads": 4,
  "d_qk": 16,
  "d_v": 16,
  "qk_n_pairs": 512,
  "qk_hidden": 32,
  "v_n_pairs": 496,
  "v_hidden": 96,
  "outproj_n_pairs": 2016,
  "outproj_hidden": 192,
  "temperature": 0.1,
  "soft_mode": "rational",
  "causal": true,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.001,
  "lr_unembedder": 0.001,
  "n_steps": 100000,
  "batch_size": 128,
  "test_batch_size": 128,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
