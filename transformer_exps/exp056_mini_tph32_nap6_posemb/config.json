{
  "exp_name": "exp056_mini_tph32_nap6_posemb",
  "description": "Same as exp055 but tph=32, nap=6 (32×2^6=2048 entries, same as exp055). Uniform pos emb init. ~2.5M params, 50k steps.",
  "model": "LUTTransformerV2",
  "vocab_size": 257,
  "embedding_dim": 32,
  "num_layers": 6,
  "num_heads": 4,
  "n_anchor_pairs": 6,
  "tables_per_head": 32,
  "n_alternatives": 1,
  "dropout": 0.0,
  "smooth_mode": false,
  "connected_anchors_mode": false,
  "initial_weights_noise": 0.001,
  "normalise_weights": false,
  "calibrate_output": false,
  "random_seed": 42,
  "optimizer": "Adam",
  "lr": 0.0001,
  "lr_unembedder": 0.001,
  "n_steps": 50000,
  "batch_size": 128,
  "test_batch_size": 256,
  "test_every": 1000,
  "lr_schedule": "warmup_cosine",
  "lr_warmup_fraction": 0.1
}
