# Copy to .env (docker compose reads it automatically) and edit.

# Fully-qualified hostname that resolves to this box; Caddy gets a Let's Encrypt cert for it and serves wss.
DOMAIN=demo.example.com

# Max concurrent viewers. Each is one MuJoCo env stepping at SPS; size to the VM's CPU.
# Default 6 suits the initial 2-vCPU / 8 GB box; raise to ~16-24 on a larger machine.
MAX_SESSIONS=6
